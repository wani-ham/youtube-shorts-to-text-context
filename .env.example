# Copy this file to .env and choose ONE option. The pipeline still runs with none,
# using local OCR for on-screen text but without visual analysis.

# Option 1: Claude (default model: claude-haiku-5-5)
# ANTHROPIC_API_KEY=

# Option 2: Gemini
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_API_KEY=
# VISION_MODEL=gemini-3.8-flash

# Option 3: OpenAI
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=gpt-5.4-mini

# Option 4: OpenRouter (use a vision model from openrouter.ai/models)
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=
# VISION_MODEL=

# Option 5: Ollama, free and on your own machine (no API key)
# VISION_BASE_URL=http://localhost:11434/v1
# VISION_MODEL=gemma4:12b
# VISION_MAX_FRAMES=12
# VISION_REASONING_EFFORT=none
# VISION_TIMEOUT_S=600

# Optional: limit how many frames are sent to the model (default 90).
# VISION_MAX_FRAMES=30

# MCP server: folders AI tools may read videos from. Local files are off until this is set.
# Separate folders with ":" on macOS and Linux, or ";" on Windows.
# VIDEO_TEXT_ALLOWED_DIRS=/Users/you/Videos

# MCP server: where results are stored (default: store/ in this project).
# VIDEO_TEXT_STORE=/Users/you/video-text-store
